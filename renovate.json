{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":automergeDigest"
  ],
  "schedule": [
    "at any time"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "ignoreTests": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "TypeScript: stay inside Angular's peer range; update this string with every Angular major (ADR 0062 D5)",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": ">=6.0 <6.1"
    },
    {
      "description": "npm (packageManager field): automerge minor and patch, a major waits (ADR 0062 D6)",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "npm (packageManager field): require manual review for major updates (ADR 0062 D6)",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Go version: group all Go version updates together to keep them in sync (backend/Containerfile, backend/go.mod, workflows, release-template.hbs)",
      "matchDatasources": [
        "golang-version"
      ],
      "groupName": "Go version",
      "groupSlug": "go-version"
    },
    {
      "description": "Bundle golang.org/x/* updates with Go version bumps so govulncheck sees a consistent set",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^golang\\.org\\/x\\//"
      ],
      "groupName": "Go version",
      "groupSlug": "go-version"
    },
    {
      "description": "Go version: automerge patch updates at once (ADR 0062 D1)",
      "matchDatasources": [
        "golang-version"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Go version: automerge minor updates after a release age of seven days (ADR 0062 D2)",
      "matchDatasources": [
        "golang-version"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Go version: require manual review for major updates",
      "matchDatasources": [
        "golang-version"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Go modules: enable updates for indirect dependencies so transitive security patches land without waiting for a direct require to bump",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Go modules: automerge minor and patch updates after CI passes",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Go modules: require manual review for major updates on direct requires",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Go modules: never open major PRs for indirect deps; module-path bumps land via the parent direct dependency",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Angular: one PR per release train for the framework, the CLI, the build system and angular-eslint, so the versions stay in step",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "/^@angular\\//",
        "/^@angular-eslint\\//",
        "angular-eslint",
        "primeng",
        "/^@primeuix\\//",
        "primeicons"
      ],
      "groupName": "Angular",
      "groupSlug": "angular"
    },
    {
      "description": "Frontend npm: automerge minor and patch updates after CI passes",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Frontend npm: require manual review for major updates (Angular majors carry migrations)",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Release tooling npm (root package.json): automerge minor and patch; the release-tooling CI job proves the set still renders notes",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Docker base images (non-Go): automerge minor and patch updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Docker base images: require manual review for major updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "PostgreSQL test image (Makefile and workflow service): stay on the 18 line; a new major is a decision, the schema relies on 18 built-ins",
      "matchDepNames": [
        "postgres"
      ],
      "matchCurrentValue": "/^18/",
      "allowedVersions": "<19"
    },
    {
      "description": "Release notes preset: conventional-changelog-conventionalcommits 10 needs conventional-changelog-writer 9, while @semantic-release/release-notes-generator 14 still brings writer 8, and hack/verify-release-tooling.mjs fails with that pair; hold the preset below 10 until the generator moves to writer 9",
      "matchDepNames": [
        "conventional-changelog-conventionalcommits"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "GitHub Actions: automerge minor and patch updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "GitHub Actions: automerge major updates after CI passes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "description": "Makefile-pinned Go tools (custom regex manager): automerge minor and patch updates at once, ahead of the Go version they must understand (ADR 0062 D3)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Makefile-pinned Go tools (custom regex manager): require manual review for major updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Use 'fix' instead of 'chore' for dependency updates",
      "semanticCommitType": "fix",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ]
    },
    {
      "description": "GitHub Actions: use 'chore' instead of 'fix' for updates",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "chore"
    }
  ],
  "customManagers": [
    {
      "description": "Update Go tool and image versions pinned in the Makefile via renovate comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n.+\\?=\\s*(?:[^\\s:@]+:)?(?<currentValue>[^\\s:@]+)\\n"
      ],
      "versioningTemplate": "{{#if (equals datasource 'docker')}}docker{{else}}semver{{/if}}"
    },
    {
      "description": "Update image digests pinned in the Makefile as tag@digest via renovate comments (the S3 test server)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\n.+\\?=\\s*[^\\s@]+:(?<currentValue>[^\\s:@/]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\n"
      ],
      "versioningTemplate": "docker"
    },
    {
      "description": "Update Go version in the backend Containerfile",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "FROM\\s+golang:(?<currentValue>[\\d.]+)-alpine"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Go version in backend/go.mod",
      "customType": "regex",
      "managerFilePatterns": [
        "/^backend/go\\.mod$/"
      ],
      "matchStrings": [
        "\\ngo\\s+(?<currentValue>[\\d.]+)\\n"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Go version in release-template.hbs badge (major.minor only)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/release-template\\.hbs$/"
      ],
      "matchStrings": [
        "go-(?<currentValue>\\d+\\.\\d+)-blue"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "description": "Update Go version in GitHub workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "GO_VERSION:\\s+['\"]?(?<currentValue>[\\d.]+)['\"]?"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update the Node.js major used by the frontend CI job",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "NODE_VERSION:\\s+['\"]?(?<currentValue>\\d+)['\"]?"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": [
      "gomodTidy",
      "gomodUpdateImportPaths"
    ]
  }
}

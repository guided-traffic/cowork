# Build stage: the Angular production bundle.
FROM node:26-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
# The PrimeUI license key (docs/adr/0052 D9) arrives as a BuildKit secret, so it is in no layer
# and no build argument; without it the bundle works and shows PrimeNG's license notice.
RUN --mount=type=secret,id=primeui_license,required=false \
    npx ng build --configuration production $(node scripts/primeui-define.mjs /run/secrets/primeui_license)

# Final stage: nginx, unprivileged, serving the bundle and nothing else; the
# Ingress routes /api/ and /auth/ to the backend (docs/adr/0001 D3).
FROM nginxinc/nginx-unprivileged:1.31-alpine

ARG BUILD_NUMBER
ARG GIT_COMMIT
ARG BUILD_TIME

LABEL org.opencontainers.image.title="cowork-frontend" \
      org.opencontainers.image.description="cowork frontend - the Angular UI of the multi-tenant backlog for people and LLM agents, served by nginx" \
      org.opencontainers.image.vendor="Guided Traffic" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.documentation="https://github.com/guided-traffic/cowork" \
      org.opencontainers.image.source="https://github.com/guided-traffic/cowork" \
      org.opencontainers.image.version="${BUILD_NUMBER:-dev}" \
      org.opencontainers.image.revision="${GIT_COMMIT:-unknown}" \
      org.opencontainers.image.created="${BUILD_TIME:-0}"

# The base image is rebuilt upstream on its own schedule. Its Alpine packages
# are brought to their latest patch level at build time, so a fix Alpine has
# published reaches the image before the next upstream rebuild; the container
# scan gates on fixed HIGH and CRITICAL findings. The image runs as 101.
USER root
RUN apk upgrade --no-cache
USER 101

# The configuration replaces the base image's default server as a plain file,
# owned by root: nothing renders it at start, and nginx's user cannot change
# it, so the container writes under /tmp only.
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend/browser/ /usr/share/nginx/html/

# nginx-unprivileged runs as user 101 and listens on 8080.
EXPOSE 8080

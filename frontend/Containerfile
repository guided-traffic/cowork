# Build stage: the Angular production bundle.
FROM node:26-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npx ng build --configuration production

# Final stage: nginx, unprivileged, serving the bundle and proxying /api/ to
# the backend. The image entrypoint renders nginx/default.conf.template with
# the four variables NGINX_ENVSUBST_FILTER names substituted (and nothing
# else: the filter keeps nginx's own $variables intact).
FROM nginxinc/nginx-unprivileged:1.30-alpine

ARG BUILD_NUMBER
ARG GIT_COMMIT
ARG BUILD_TIME

LABEL org.opencontainers.image.title="cowork-frontend" \
      org.opencontainers.image.description="cowork frontend - the Angular UI of the multi-tenant backlog for people and LLM agents, served by nginx" \
      org.opencontainers.image.vendor="Guided Traffic" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.documentation="https://github.com/guided-traffic/cowork" \
      org.opencontainers.image.source="https://github.com/guided-traffic/cowork" \
      org.opencontainers.image.version="${BUILD_NUMBER:-dev}" \
      org.opencontainers.image.revision="${GIT_COMMIT:-unknown}" \
      org.opencontainers.image.created="${BUILD_TIME:-0}"

# NGINX_ENTRYPOINT_LOCAL_RESOLVERS makes the entrypoint export the nameservers
# of /etc/resolv.conf as NGINX_LOCAL_RESOLVERS; the template's resolver
# directive needs them. The body size and the read timeout default to the
# backend's defaults with headroom (10MiB uploads, 30s requests); the chart
# sets them from its values (docs/adr/0039 D3). BACKEND_URL names a host the
# run provides: never localhost:8080, which is nginx itself and would proxy
# every /api/ request back into the proxy.
ENV BACKEND_URL=http://backend:8080 \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=true \
    NGINX_CLIENT_MAX_BODY_SIZE=11m \
    NGINX_PROXY_READ_TIMEOUT=40s \
    NGINX_ENVSUBST_FILTER='^(BACKEND_URL|NGINX_LOCAL_RESOLVERS|NGINX_CLIENT_MAX_BODY_SIZE|NGINX_PROXY_READ_TIMEOUT)$'

COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist/frontend/browser/ /usr/share/nginx/html/

# nginx-unprivileged runs as user 101 and listens on 8080.
EXPOSE 8080

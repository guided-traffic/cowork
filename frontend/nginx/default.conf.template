# Rendered into /etc/nginx/conf.d/default.conf by the image entrypoint. Four
# variables are substituted (NGINX_ENVSUBST_FILTER in the Containerfile):
# ${BACKEND_URL}, the backend Service; ${NGINX_LOCAL_RESOLVERS}, which the
# entrypoint reads from /etc/resolv.conf; ${NGINX_CLIENT_MAX_BODY_SIZE} and
# ${NGINX_PROXY_READ_TIMEOUT}, the body size and the read timeout, which the
# chart sets from the backend's limits with headroom so the backend answers
# its own 413 and 504 (docs/adr/0039 D3). Everything else that looks like a
# variable is nginx's own and stays as written.

# The access log carries the time, the method, the path, the status, the size
# and the duration — never the query, which holds search terms and filters,
# and no header: the backend's request log keeps the same rule.
log_format cowork '[$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';

server {
    listen       8080;
    server_name  _;
    server_tokens off;
    access_log   /dev/stdout cowork;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # The frontend's own health: answered by nginx, says nothing about the backend.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # The API, proxied to the backend Service. ^~ keeps the static-file
    # regex below from taking an API path that ends in .png or .svg. The
    # upstream is held in a variable so nginx resolves it per request through
    # the cluster DNS instead of once at start: the frontend then starts
    # before the backend Service exists and follows it when its address
    # changes. The request path is passed through unchanged.
    location ^~ /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};

        # What nginx answers itself is a problem body as well
        # (docs/adr/0047 D6). The backend's own 5xx pass through untouched:
        # proxy_intercept_errors stays off.
        error_page 413 @payload_too_large;
        error_page 502 @backend_unreachable;
        error_page 503 @not_ready;
        error_page 504 @timeout;

        # The event stream (docs/adr/0054 D6): unbuffered, uncached, an hour
        # of quiet allowed between the heartbeats.
        location ~ ^/api/v1/tenants/[^/]+/events$ {
            set $backend ${BACKEND_URL};
            proxy_pass $backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection        "";
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 1h;
        }
    }

    location @payload_too_large {
        default_type "application/problem+json; charset=utf-8";
        return 413 '{"type":"https://cowork.dev/problems/payload-too-large","title":"Payload too large","status":413,"detail":"the request is larger than the proxy passes","code":"payload_too_large"}';
    }
    location @backend_unreachable {
        default_type "application/problem+json; charset=utf-8";
        return 502 '{"type":"https://cowork.dev/problems/backend-unreachable","title":"Backend unreachable","status":502,"detail":"the proxy could not reach the backend","code":"backend_unreachable"}';
    }
    location @not_ready {
        default_type "application/problem+json; charset=utf-8";
        return 503 '{"type":"https://cowork.dev/problems/not-ready","title":"Not ready","status":503,"detail":"the backend is not ready","code":"not_ready"}';
    }
    location @timeout {
        default_type "application/problem+json; charset=utf-8";
        return 504 '{"type":"https://cowork.dev/problems/timeout","title":"Timeout","status":504,"detail":"the backend did not answer in time","code":"timeout"}';
    }

    # The icon from public/ keeps its name across builds: revalidated, never
    # immutable.
    location = /favicon.ico {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # Hashed bundles never change under their name.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The application shell: every path the router owns resolves to it, and it
    # is never cached, because it names the current bundle hashes.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store";
    }
}
